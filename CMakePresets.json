{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CANVAS_BUILD_TESTS": "ON"
      }
    },

    {
      "name": "macos-arm64",
      "displayName": "macOS arm64 (Apple Silicon)",
      "description": "Release build for Apple Silicon. Metal GPU backend.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":        "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CMAKE_PREFIX_PATH": "$env{Qt6_DIR}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },

    {
      "name": "macos-x64",
      "displayName": "macOS x86_64 (Intel)",
      "description": "Release build for Intel Macs. Metal GPU backend.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":        "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CMAKE_PREFIX_PATH": "$env{Qt6_DIR}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },

    {
      "name": "macos-universal",
      "displayName": "macOS Universal Binary",
      "description": "Universal binary for both arm64 and x86_64.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":        "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CMAKE_PREFIX_PATH": "$env{Qt6_DIR}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },

    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "description": "Release build for Windows x64. Direct3D 12 GPU backend.",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_PREFIX_PATH": "$env{Qt6_DIR}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },

    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "description": "Debug build with full symbols and ASan.",
      "inherits": "windows-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CANVAS_ASAN": "ON"
      }
    },

    {
      "name": "linux-x64",
      "displayName": "Linux x64",
      "description": "Release build for Linux x64. Vulkan GPU backend.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_PREFIX_PATH": "$env{Qt6_DIR}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },

    {
      "name": "linux-arm64",
      "displayName": "Linux arm64",
      "description": "Release build for Linux arm64 (Raspberry Pi 5, ARM servers).",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_PREFIX_PATH": "$env{Qt6_DIR}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },

    {
      "name": "linux-debug",
      "displayName": "Linux Debug + ASan",
      "description": "Debug build with AddressSanitizer and UBSan.",
      "inherits": "linux-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CANVAS_ASAN": "ON"
      }
    },

    {
      "name": "ci",
      "displayName": "CI — auto-detect platform",
      "description": "Used by GitHub Actions. Platform detected from runner OS.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{Qt6_DIR}"
      }
    }
  ],

  "buildPresets": [
    { "name": "macos-arm64",     "configurePreset": "macos-arm64",     "jobs": 0 },
    { "name": "macos-x64",       "configurePreset": "macos-x64",       "jobs": 0 },
    { "name": "macos-universal",  "configurePreset": "macos-universal",  "jobs": 0 },
    { "name": "windows-x64",     "configurePreset": "windows-x64",     "jobs": 0 },
    { "name": "windows-x64-debug","configurePreset": "windows-x64-debug","jobs": 0 },
    { "name": "linux-x64",       "configurePreset": "linux-x64",       "jobs": 0 },
    { "name": "linux-arm64",     "configurePreset": "linux-arm64",     "jobs": 0 },
    { "name": "linux-debug",     "configurePreset": "linux-debug",     "jobs": 0 },
    { "name": "ci",              "configurePreset": "ci",              "jobs": 0 }
  ],

  "testPresets": [
    {
      "name": "default",
      "configurePreset": "linux-x64",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4, "timeout": 120 }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": { "outputOnFailure": true, "verbosity": "extra" },
      "execution": { "jobs": 4, "timeout": 300 }
    }
  ]
}
